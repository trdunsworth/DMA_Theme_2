    "editorGroup.emptyBackground": "#F8FAFC",
    "focusBorder": "#0077CC",
    "contrastBorder": "#B8CCDB",
    "textLink.foreground": "#0077CC",
    "textLink.activeForeground": "#005A9E",
    "textPreformat.foreground": "#008F33",
    "textCodeBlock.background": "#F0F4F8",
    "textBlockQuote.background": "#F0F4F8",
    "textBlockQuote.border": "#0077CC"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#5A7D96",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment - Documentation",
      "scope": "comment.documentation",
      "settings": {
        "foreground": "#5A7D96",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "constant.other.symbol"],
      "settings": {
        "foreground": "#008F33"
      }
    },
    {
      "name": "String - Punctuation",
      "scope": ["punctuation.definition.string.begin", "punctuation.definition.string.end"],
      "settings": {
        "foreground": "#008F33"
      }
    },
    {
      "name": "String - Escape",
      "scope": ["constant.character.escape", "string constant.character.escape"],
      "settings": {
        "foreground": "#E88800",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric", "constant.language.boolean"],
      "settings": {
        "foreground": "#005A9E"
      }
    },
    {
      "name": "Constants",
      "scope": ["constant", "constant.language", "variable.other.constant"],
      "settings": {
        "foreground": "#8C5A00"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#005A5A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keyword - Operator",
      "scope": ["keyword.operator", "keyword.operator.new", "keyword.operator.expression"],
      "settings": {
        "foreground": "#005A5A"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "entity.name.method"],
      "settings": {
        "foreground": "#005A9E"
      }
    },
    {
      "name": "Function Call",
      "scope": "meta.function-call",
      "settings": {
        "foreground": "#005A9E"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": {
        "foreground": "#1A2A35"
      }
    },
    {
      "name": "Variable - Parameter",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#3D5A6E"
      }
    },
    {
      "name": "Types",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.interface", "support.type", "entity.name.namespace"],
      "settings": {
        "foreground": "#007373",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type Parameters",
      "scope": "typeParameter",
      "settings": {
        "foreground": "#007373"
      }
    },
    {
      "name": "Properties",
      "scope": ["variable.property", "entity.name.property", "meta.object-literal.key"],
      "settings": {
        "foreground": "#1A2A35"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.id", "entity.other.attribute-name.class"],
      "settings": {
        "foreground": "#008C8C"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#005A5A"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "keyword.operator.arithmetic", "keyword.operator.logical", "keyword.operator.comparison"],
      "settings": {
        "foreground": "#005A5A"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator"],
      "settings": {
        "foreground": "#3D5A6E"
      }
    },
    {
      "name": "Brackets",
      "scope": ["punctuation.section.brackets", "punctuation.section.braces", "punctuation.section.parens"],
      "settings": {
        "foreground": "#5A7D96"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": ["string.regexp", "constant.character.escape", "constant.other.character-class.regexp"],
      "settings": {
        "foreground": "#8C5A00"
      }
    },
    {
      "name": "Annotations/Decorators",
      "scope": ["entity.name.annotation", "storage.type.annotation", "entity.name.decorator"],
      "settings": {
        "foreground": "#008C8C"
      }
    },
    {
      "name": "Preprocessor",
      "scope": ["keyword.other.preprocessor", "entity.name.preprocessor"],
      "settings": {
        "foreground": "#008C8C"
      }
    },
    {
      "name": "Invalid/Error",
      "scope": ["invalid", "invalid.deprecated", "invalid.illegal"],
      "settings": {
        "foreground": "#E80000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup - Heading",
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": {
        "foreground": "#005A5A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup - Bold",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#1A2A35",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup - Italic",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#1A2A35",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup - Strikethrough",
      "scope": "markup.strikethrough",
      "settings": {
        "foreground": "#5A7D96",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup - Code",
      "scope": ["markup.inline.raw", "markup.raw.block"],
      "settings": {
        "foreground": "#008F33",
        "background": "#F0F4F8"
      }
    },
    {
      "name": "Markup - Link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#0077CC",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup - Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#5A7D96",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup - List",
      "scope": ["markup.list", "punctuation.definition.list"],
      "settings": {
        "foreground": "#005A5A"
      }
    },
    {
      "name": "Markup - Table",
      "scope": "markup.table",
      "settings": {
        "foreground": "#1A2A35"
      }
    },
    {
      "name": "Diff - Added",
      "scope": ["markup.inserted", "meta.diff.header.from-file", "meta.diff.header.to-file"],
      "settings": {
        "foreground": "#005A1F",
        "background": "#D4F0D4"
      }
    },
    {
      "name": "Diff - Removed",
      "scope": ["markup.deleted", "meta.diff.header"],
      "settings": {
        "foreground": "#8C0000",
        "background": "#FAD4D4"
      }
    },
    {
      "name": "Diff - Changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#8C5A00",
        "background": "#FFF8E6"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "#6E89A0",
    "string": "#007F2A",
    "number": "#00529E",
    "regexp": "#7A4A00",
    "keyword": "#004D4D",
    "keyword.control": "#004D4D",
    "storage": "#004D4D",
    "variable": "#1E282D",
    "variable.parameter": "#485C6E",
    "variable.property": "#1E282D",
    "variable.constant": "#7A4A00",
    "function": "#00529E",
    "method": "#00529E",
    "type": "#006666",
    "class": "#006666",
    "interface": "#006666",
    "enum": "#006666",
    "enumMember": "#7A4A00",
    "namespace": "#007F7F",
    "parameter": "#485C6E",
    "property": "#1E282D",
    "operator": "#004D4D",
    "punctuation": "#485C6E",
    "decorator": "#007F7F",
    "annotation": "#007F7F",
    "macro": "#007F7F",
    "label": "#6E89A0",
    "typeParameter": "#006666",
    "selfParameter": "#1E282D"
  }
}