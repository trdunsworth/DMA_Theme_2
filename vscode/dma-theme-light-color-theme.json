    "breadcrumb.foreground": "#5A7D96",
    "breadcrumb.focusForeground": "#1A2A35",
    "breadcrumb.activeSelectionForeground": "#1A2A35",
    "breadcrumbPicker.background": "#FFFFFF",
    "menubar.background": "#F0F4F8",
