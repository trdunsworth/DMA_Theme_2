    "terminal.ansiCyan": "#00B3B3",
    "terminal.ansiWhite": "#B8CCDB",
    "terminal.ansiBrightBlack": "#3D5A6E",
    "terminal.ansiBrightRed": "#FF1A1A",
    "terminal.ansiBrightGreen": "#00B33B",
    "terminal.ansiBrightYellow": "#FF9F00",
    "terminal.ansiBrightBlue": "#1A91E6",
    "terminal.ansiBrightMagenta": "#1ACECE",
    "terminal.ansiBrightCyan": "#4DDDDD",
