  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6E89A0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment - Documentation",
      "scope": "comment.documentation",
      "settings": {
        "foreground": "#6E89A0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "constant.other.symbol"],
      "settings": {
        "foreground": "#4DD966"
      }
    },
    {
      "name": "String - Punctuation",
      "scope": ["punctuation.definition.string.begin", "punctuation.definition.string.end"],
      "settings": {
        "foreground": "#4DD966"
      }
    },
    {
      "name": "String - Escape",
      "scope": ["constant.character.escape", "string constant.character.escape"],
      "settings": {
        "foreground": "#EF9F76",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric", "constant.language.boolean"],
      "settings": {
        "foreground": "#4DA8EE"
      }
    },
    {
      "name": "Constants",
      "scope": ["constant", "constant.language", "variable.other.constant"],
      "settings": {
        "foreground": "#E5C890"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#4DE5E5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keyword - Operator",
      "scope": ["keyword.operator", "keyword.operator.new", "keyword.operator.expression"],
      "settings": {
        "foreground": "#4DE5E5"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "entity.name.method"],
      "settings": {
        "foreground": "#4DA8EE"
      }
    },
    {
      "name": "Function Call",
      "scope": "meta.function-call",
      "settings": {
        "foreground": "#4DA8EE"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": {
        "foreground": "#E0E8EF"
      }
    },
    {
      "name": "Variable - Parameter",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#93ABC3"
      }
    },
    {
      "name": "Types",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.interface", "support.type", "entity.name.namespace"],
      "settings": {
        "foreground": "#81C8BE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type Parameters",
      "scope": "typeParameter",
      "settings": {
        "foreground": "#81C8BE"
      }
    },
    {
      "name": "Properties",
      "scope": ["variable.property", "entity.name.property", "meta.object-literal.key"],
      "settings": {
        "foreground": "#E0E8EF"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.id", "entity.other.attribute-name.class"],
      "settings": {
        "foreground": "#94E2D5"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#4DE5E5"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "keyword.operator.arithmetic", "keyword.operator.logical", "keyword.operator.comparison"],
      "settings": {
        "foreground": "#4DE5E5"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator"],
      "settings": {
        "foreground": "#93ABC3"
      }
    },
    {
      "name": "Brackets",
      "scope": ["punctuation.section.brackets", "punctuation.section.braces", "punctuation.section.parens"],
      "settings": {
        "foreground": "#6E89A0"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": ["string.regexp", "constant.character.escape", "constant.other.character-class.regexp"],
      "settings": {
        "foreground": "#E5C890"
      }
    },
    {
      "name": "Annotations/Decorators",
      "scope": ["entity.name.annotation", "storage.type.annotation", "entity.name.decorator"],
      "settings": {
        "foreground": "#94E2D5"
      }
    },
    {
      "name": "Preprocessor",
      "scope": ["keyword.other.preprocessor", "entity.name.preprocessor"],
      "settings": {
        "foreground": "#94E2D5"
      }
    },
    {
      "name": "Invalid/Error",
      "scope": ["invalid", "invalid.deprecated", "invalid.illegal"],
      "settings": {
        "foreground": "#FF1A1A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup - Heading",
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": {
        "foreground": "#4DE5E5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup - Bold",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#E0E8EF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup - Italic",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#E0E8EF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup - Strikethrough",
      "scope": "markup.strikethrough",
      "settings": {
        "foreground": "#6E89A0",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup - Code",
      "scope": ["markup.inline.raw", "markup.raw.block"],
      "settings": {
        "foreground": "#4DD966",
        "background": "#101820"
      }
    },
    {
      "name": "Markup - Link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#4DA8EE",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup - Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#6E89A0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup - List",
      "scope": ["markup.list", "punctuation.definition.list"],
      "settings": {
        "foreground": "#4DE5E5"
      }
    },
    {
      "name": "Markup - Table",
      "scope": "markup.table",
      "settings": {
        "foreground": "#E0E8EF"
      }
    },
    {
      "name": "Diff - Added",
      "scope": ["markup.inserted", "meta.diff.header.from-file", "meta.diff.header.to-file"],
      "settings": {
        "foreground": "#E6F8E6",
        "background": "#004D1A"
      }
    },
    {
      "name": "Diff - Removed",
      "scope": ["markup.deleted", "meta.diff.header"],
      "settings": {
        "foreground": "#FFEAEA",
        "background": "#7A0000"
      }
    },
    {
      "name": "Diff - Changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#FFF8E6",
        "background": "#7A4A00"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "#6E89A0",
    "string": "#4DD966",
    "number": "#4DA8EE",
    "regexp": "#E5C890",
    "keyword": "#4DE5E5",
    "keyword.control": "#4DE5E5",
    "storage": "#4DE5E5",
    "variable": "#E0E8EF",
    "variable.parameter": "#93ABC3",
    "variable.property": "#E0E8EF",
    "variable.constant": "#E5C890",
    "function": "#4DA8EE",
    "method": "#4DA8EE",
    "type": "#81C8BE",
    "class": "#81C8BE",
    "interface": "#81C8BE",
    "enum": "#81C8BE",
    "enumMember": "#E5C890",
    "namespace": "#94E2D5",
    "parameter": "#93ABC3",
    "property": "#E0E8EF",
    "operator": "#4DE5E5",
    "punctuation": "#93ABC3",
    "decorator": "#94E2D5",
    "annotation": "#94E2D5",
    "macro": "#94E2D5",
    "label": "#6E89A0",
    "typeParameter": "#81C8BE",
    "selfParameter": "#E0E8EF"
  }
}