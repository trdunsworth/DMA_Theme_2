# DMA Theme Dark for Kakoune
# Blues, teals, turquoises, and greens; warm error/warning accents.
# Dunsworth-Mann Analytics LLC - https://dunsworth-mann.com
# Flat `face global <Name> <spec>` per `:doc faces`. Canonical names.

face global Default             rgb:E0E8EF,rgb:0A0F14
face global BufferPadding       rgb:93ABC3,rgb:0A0F14
face global Information         rgb:E0E8EF,rgb:2D4058
face global InlineInformation   rgb:E0E8EF,rgb:2D4058
face global Error               rgb:FF1A1A,rgb:2D4058+b
face global Prompt              rgb:4DA8EE,rgb:0A0F14+b
face global MenuForeground      rgb:F8FAFC,rgb:003D7A
face global MenuBackground      rgb:E0E8EF,rgb:2D4058
face global MenuInfo            rgb:93ABC3,rgb:2D4058
face global MatchingChar        rgb:0A0F14,rgb:4DA8EE+bu
face global PrimaryCursor       rgb:0A0F14,rgb:4DA8EE
face global SecondaryCursor     rgb:0A0F14,rgb:003D7A
face global PrimaryCursorEol    rgb:0A0F14,rgb:4DA8EE
face global SecondaryCursorEol  rgb:0A0F14,rgb:003D7A
face global PrimarySelection    rgb:F8FAFC,rgb:003D7A
face global SecondarySelection  rgb:E0E8EF,rgb:2D4058
face global StatusLine          rgb:E0E8EF,rgb:182430+b
face global StatusLineMode      rgb:0A0F14,rgb:4DA8EE+b
face global StatusLineInfo      rgb:93ABC3
face global StatusLineValue     rgb:1A91E6
face global StatusCursor        rgb:0A0F14,rgb:4DA8EE
face global LineNumbers         rgb:93ABC3,rgb:0A0F14
face global LineNumberCursor    rgb:4DA8EE,rgb:0A0F14+b
face global LineNumbersWrapped  rgb:E0E8EF,rgb:0A0F14
face global Whitespace          rgb:2A3A4A
face global WrapMarker          rgb:2A3A4A
face global Search              rgb:0A0F14,rgb:FF9F00+b
face global DiagnosticError     rgb:FF1A1A
face global DiagnosticWarning   rgb:FF9F00
face global comment             rgb:93ABC3+i
face global documentation       rgb:93ABC3+i
face global string              rgb:00B33B
face global value               rgb:FF9F00
face global function            rgb:1A91E6
face global type                rgb:00B3B3+b
face global variable            rgb:E0E8EF
face global module              rgb:1ACECE
face global keyword             rgb:4DA8EE+b
face global operator            rgb:93ABC3
face global attribute           rgb:1ACECE
face global builtin             rgb:1ACECE+b
face global meta                rgb:1ACECE
face global identifier          rgb:E0E8EF
face global mono                rgb:E0E8EF
face global block               rgb:007FDB
face global link                rgb:4DA8EE+u
face global bullet              rgb:007FDB
face global list                rgb:4DA8EE
face global header              rgb:4DA8EE
face global title               rgb:4DA8EE