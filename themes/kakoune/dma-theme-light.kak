# DMA Theme Light for Kakoune
# A semantic color theme focused on blues, teals, turquoises, and greens
# with warm error/warning colors.
# Author: Dunsworth-Mann Analytics LLC
# https://dunsworth-mann.com

# Colors
declare-option -hidden colorscheme_dma_blue_900 "#002B5C"
declare-option -hidden colorscheme_dma_blue_800 "#003D7A"
declare-option -hidden colorscheme_dma_blue_700 "#00529E"
declare-option -hidden colorscheme_dma_blue_600 "#0069C0"
declare-option -hidden colorscheme_dma_blue_500 "#0077CC"
declare-option -hidden colorscheme_dma_blue_400 "#1A91E6"
declare-option -hidden colorscheme_dma_blue_300 "#4DA8EE"
declare-option -hidden colorscheme_dma_blue_200 "#8FC3F5"
declare-option -hidden colorscheme_dma_blue_100 "#C5DEF9"
declare-option -hidden colorscheme_dma_blue_50 "#E8F4FC"

declare-option -hidden colorscheme_dma_teal_900 "#004D4D"
declare-option -hidden colorscheme_dma_teal_800 "#006666"
declare-option -hidden colorscheme_dma_teal_700 "#007F7F"
declare-option -hidden colorscheme_dma_teal_600 "#009999"
declare-option -hidden colorscheme_dma_teal_500 "#00B3B3"
declare-option -hidden colorscheme_dma_teal_400 "#1ACCCC"
declare-option -hidden colorscheme_dma_teal_300 "#4DE5E5"
declare-option -hidden colorscheme_dma_teal_200 "#99F0F0"
declare-option -hidden colorscheme_dma_teal_100 "#CCF7F7"
declare-option -hidden colorscheme_dma_teal_50 "#E6FBFB"

declare-option -hidden colorscheme_dma_turquoise_900 "#005C5C"
declare-option -hidden colorscheme_dma_turquoise_800 "#007373"
declare-option -hidden colorscheme_dma_turquoise_700 "#008A8A"
declare-option -hidden colorscheme_dma_turquoise_600 "#00A1A1"
declare-option -hidden colorscheme_dma_turquoise_500 "#00B8B8"
declare-option -hidden colorscheme_dma_turquoise_400 "#1ACECE"
declare-option -hidden colorscheme_dma_turquoise_300 "#4DDDDD"
declare-option -hidden colorscheme_dma_turquoise_200 "#99EDED"
declare-option -hidden colorscheme_dma_turquoise_100 "#CCF6F6"
declare-option -hidden colorscheme_dma_turquoise_50 "#E6FBFB"

declare-option -hidden colorscheme_dma_green_900 "#004D1A"
declare-option -hidden colorscheme_dma_green_800 "#006622"
declare-option -hidden colorscheme_dma_green_700 "#007F2A"
declare-option -hidden colorscheme_dma_green_600 "#009933"
declare-option -hidden colorscheme_dma_green_500 "#00B33B"
declare-option -hidden colorscheme_dma_green_400 "#1ACC4D"
declare-option -hidden colorscheme_dma_green_300 "#4DD966"
declare-option -hidden colorscheme_dma_green_200 "#99E599"
declare-option -hidden colorscheme_dma_green_100 "#CCF0CC"
declare-option -hidden colorscheme_dma_green_50 "#E6F8E6"

declare-option -hidden colorscheme_dma_error_900 "#7A0000"
declare-option -hidden colorscheme_dma_error_800 "#9E0000"
declare-option -hidden colorscheme_dma_error_700 "#C40000"
declare-option -hidden colorscheme_dma_error_600 "#E80000"
declare-option -hidden colorscheme_dma_error_500 "#FF1A1A"
declare-option -hidden colorscheme_dma_error_400 "#FF4D4D"
declare-option -hidden colorscheme_dma_error_300 "#FF7A7A"
declare-option -hidden colorscheme_dma_error_200 "#FFA8A8"
declare-option -hidden colorscheme_dma_error_100 "#FFD4D4"
declare-option -hidden colorscheme_dma_error_50 "#FFEAEA"

declare-option -hidden colorscheme_dma_warning_900 "#7A4A00"
declare-option -hidden colorscheme_dma_warning_800 "#9E5E00"
declare-option -hidden colorscheme_dma_warning_700 "#C47300"
declare-option -hidden colorscheme_dma_warning_600 "#E88800"
declare-option -hidden colorscheme_dma_warning_500 "#FF9F00"
declare-option -hidden colorscheme_dma_warning_400 "#FFAD33"
declare-option -hidden colorscheme_dma_warning_300 "#FFC466"
declare-option -hidden colorscheme_dma_warning_200 "#FFDB99"
declare-option -hidden colorscheme_dma_warning_100 "#FFF0CC"
declare-option -hidden colorscheme_dma_warning_50 "#FFF8E6"

declare-option -hidden colorscheme_dma_info_900 "#003D7A"
declare-option -hidden colorscheme_dma_info_800 "#00529E"
declare-option -hidden colorscheme_dma_info_700 "#0069C0"
declare-option -hidden colorscheme_dma_info_600 "#0077CC"
declare-option -hidden colorscheme_dma_info_500 "#0091E6"
declare-option -hidden colorscheme_dma_info_400 "#33A8EE"
declare-option -hidden colorscheme_dma_info_300 "#66BFFF"
declare-option -hidden colorscheme_dma_info_200 "#99D4FF"
declare-option -hidden colorscheme_dma_info_100 "#CCE9FF"
declare-option -hidden colorscheme_dma_info_50 "#E6F4FF"

declare-option -hidden colorscheme_dma_success_900 "#004D1A"
declare-option -hidden colorscheme_dma_success_800 "#006622"
declare-option -hidden colorscheme_dma_success_700 "#007F2A"
declare-option -hidden colorscheme_dma_success_600 "#009933"
declare-option -hidden colorscheme_dma_success_500 "#00B33B"
declare-option -hidden colorscheme_dma_success_400 "#33CC5A"
declare-option -hidden colorscheme_dma_success_300 "#66D97A"
declare-option -hidden colorscheme_dma_success_200 "#99E599"
declare-option -hidden colorscheme_dma_success_100 "#CCF0CC"
declare-option -hidden colorscheme_dma_success_50 "#E6F8E6"

declare-option -hidden colorscheme_dma_bg "#F8FAFC"
declare-option -hidden colorscheme_dma_bg_alt "#F0F4F8"
declare-option -hidden colorscheme_dma_bg_elevated "#FFFFFF"
declare-option -hidden colorscheme_dma_fg "#1A2A35"
declare-option -hidden colorscheme_dma_fg_muted "#485C6E"
declare-option -hidden colorscheme_dma_fg_subtle "#6E89A0"
declare-option -hidden colorscheme_dma_border "#A8C0D8"
declare-option -hidden colorscheme_dma_border_focus "#0077CC"
declare-option -hidden colorscheme_dma_selection "#A8D0F0"
declare-option -hidden colorscheme_dma_selection_fg "#002B5C"
declare-option -hidden colorscheme_dma_cursor "#0077CC"
declare-option -hidden colorscheme_dma_line_nr "#6E89A0"
declare-option -hidden colorscheme_dma_line_nr_active "#005A9E"

# Face definitions
set-face global Default $colorscheme_dma_fg $colorscheme_dma_bg
set-face global Cursor $colorscheme_dma_bg $colorscheme_dma_cursor
set-face global CursorLine - $colorscheme_dma_bg_alt
set-face global CursorColumn - $colorscheme_dma_bg_alt
set-face global ColorColumn - $colorscheme_dma_bg_alt

set-face global LineNumber $colorscheme_dma_line_nr $colorscheme_dma_bg
set-face global CursorLineNumber $colorscheme_dma_line_nr_active $colorscheme_dma_bg bold

set-face global MatchingChar $colorscheme_dma_cursor $colorscheme_dma_selection bold,underline

set-face global Selection $colorscheme_dma_selection_fg $colorscheme_dma_selection
set-face global PrimarySelection $colorscheme_dma_selection_fg $colorscheme_dma_selection
set-face global SecondarySelection $colorscheme_dma_fg $colorscheme_dma_bg_alt

set-face global SearchMatch $colorscheme_dma_success_900 $colorscheme_dma_success_50
set-face global SearchMatchCursor $colorscheme_dma_error_900 $colorscheme_dma_error_50

set-face global StatusLine $colorscheme_dma_fg $colorscheme_dma_bg_alt
set-face global ModeLine $colorscheme_dma_fg $colorscheme_dma_bg_alt
set-face global ModelineInfo $colorscheme_dma_fg_subtle $colorscheme_dma_bg_alt

set-face global Menu $colorscheme_dma_fg $colorscheme_dma_bg_elevated
set-face global MenuSelected $colorscheme_dma_selection_fg $colorscheme_dma_selection

set-face global Prompt $colorscheme_dma_cursor $colorscheme_dma_bg bold
set-face global PromptPrefix $colorscheme_dma_cursor $colorscheme_dma_bg bold
set-face global Info $colorscheme_dma_info_500 $colorscheme_dma_bg
set-face global Error $colorscheme_dma_error_500 $colorscheme_dma_error_50 bold

set-face global Border $colorscheme_dma_border $colorscheme_dma_bg
set-face global BorderFocused $colorscheme_dma_border_focus $colorscheme_dma_bg

# Syntax highlighting faces
set-face global Comment $colorscheme_dma_fg_subtle $colorscheme_dma_bg italic
set-face global CommentSpecial $colorscheme_dma_warning_500 $colorscheme_dma_bg bold
set-face global CommentDocumentation $colorscheme_dma_fg_subtle $colorscheme_dma_bg italic

set-face global Constant $colorscheme_dma_warning_600 $colorscheme_dma_bg
set-face global String $colorscheme_dma_green_500 $colorscheme_dma_bg
set-face global Character $colorscheme_dma_green_500 $colorscheme_dma_bg
set-face global Number $colorscheme_dma_blue_500 $colorscheme_dma_bg
set-face global Boolean $colorscheme_dma_blue_500 $colorscheme_dma_bg
set-face global Float $colorscheme_dma_blue_500 $colorscheme_dma_bg

set-face global Identifier $colorscheme_dma_fg $colorscheme_dma_bg
set-face global Function $colorscheme_dma_blue_500 $colorscheme_dma_bg
set-face global Method $colorscheme_dma_blue_500 $colorscheme_dma_bg

set-face global Statement $colorscheme_dma_teal_600 $colorscheme_dma_bg bold
set-face global Conditional $colorscheme_dma_teal_600 $colorscheme_dma_bg bold
set-face global Repeat $colorscheme_dma_teal_600 $colorscheme_dma_bg bold
set-face global Label $colorscheme_dma_teal_600 $colorscheme_dma_bg
set-face global Operator $colorscheme_dma_teal_600 $colorscheme_dma_bg
set-face global Keyword $colorscheme_dma_teal_600 $colorscheme_dma_bg bold
set-face global Exception $colorscheme_dma_teal_600 $colorscheme_dma_bg

set-face global PreProc $colorscheme_dma_turquoise_500 $colorscheme_dma_bg
set-face global Include $colorscheme_dma_turquoise_500 $colorscheme_dma_bg
set-face global Define $colorscheme_dma_turquoise_500 $colorscheme_dma_bg
set-face global Macro $colorscheme_dma_turquoise_500 $colorscheme_dma_bg
set-face global PreCondit $colorscheme_dma_turquoise_500 $colorscheme_dma_bg

set-face global Type $colorscheme_dma_teal_500 $colorscheme_dma_bg bold
set-face global StorageClass $colorscheme_dma_teal_600 $colorscheme_dma_bg
set-face global Structure $colorscheme_dma_teal_500 $colorscheme_dma_bg bold
set-face global Typedef $colorscheme_dma_teal_500 $colorscheme_dma_bg bold

set-face global Special $colorscheme_dma_warning_500 $colorscheme_dma_bg
set-face global SpecialChar $colorscheme_dma_warning_500 $colorscheme_dma_bg bold
set-face global Tag $colorscheme_dma_teal_600 $colorscheme_dma_bg
set-face global Delimiter $colorscheme_dma_fg_muted $colorscheme_dma_bg
set-face global SpecialComment $colorscheme_dma_fg_subtle $colorscheme_dma_bg
set-face global Debug $colorscheme_dma_error_500 $colorscheme_dma_bg

set-face global Underlined - $colorscheme_dma_bg underline
set-face global Bold - $colorscheme_dma_bg bold
set-face global Italic - $colorscheme_dma_bg italic
set-face global Strikethrough - $colorscheme_dma_bg strikethrough

# Diff faces
set-face global DiffAdd $colorscheme_dma_success_900 $colorscheme_dma_success_50
set-face global DiffDelete $colorscheme_dma_error_900 $colorscheme_dma_error_50
set-face global DiffChange $colorscheme_dma_warning_900 $colorscheme_dma_warning_50
set-face global DiffText $colorscheme_dma_info_900 $colorscheme_dma_info_50

# Git faces
set-face global GitAdded $colorscheme_dma_green_600 $colorscheme_dma_bg
set-face global GitModified $colorscheme_dma_blue_500 $colorscheme_dma_bg
set-face global GitDeleted $colorscheme_dma_error_500 $colorscheme_dma_bg
set-face global GitUntracked $colorscheme_dma_green_600 $colorscheme_dma_bg
set-face global GitIgnored $colorscheme_dma_fg_subtle $colorscheme_dma_bg
set-face global GitConflicting #9E5E00 $colorscheme_dma_bg

# LSP faces
set-face global LspError $colorscheme_dma_error_500 $colorscheme_dma_bg
set-face global LspWarning $colorscheme_dma_warning_500 $colorscheme_dma_bg
set-face global LspInfo $colorscheme_dma_info_500 $colorscheme_dma_bg
set-face global LspHint $colorscheme_dma_success_500 $colorscheme_dma_bg

set-face global LspDiagnosticError $colorscheme_dma_error_500 $colorscheme_dma_bg
set-face global LspDiagnosticWarning $colorscheme_dma_warning_500 $colorscheme_dma_bg
set-face global LspDiagnosticInfo $colorscheme_dma_info_500 $colorscheme_dma_bg
set-face global LspDiagnosticHint $colorscheme_dma_success_500 $colorscheme_dma_bg

set-face global LspReferenceText - $colorscheme_dma_selection
set-face global LspReferenceRead - $colorscheme_dma_selection
set-face global LspReferenceWrite - $colorscheme_dma_selection underline

set-face global LspCodeLens $colorscheme_dma_fg_subtle $colorscheme_dma_bg
set-face global LspCodeLensSeparator $colorscheme_dma_fg_subtle $colorscheme_dma_bg

# Completion faces
set-face global Completion $colorscheme_dma_fg $colorscheme_dma_bg_alt
set-face global CompletionCurrent $colorscheme_dma_fg $colorscheme_dma_selection
set-face global CompletionInfo $colorscheme_dma_fg_subtle $colorscheme_dma_bg_alt
set-face global CompletionKind $colorscheme_dma_teal_800 $colorscheme_dma_bg_alt
set-face global CompletionMenu $colorscheme_dma_fg $colorscheme_dma_bg_alt
set-face global CompletionScrollbar $colorscheme_dma_fg_subtle $colorscheme_dma_border

# Tree-sitter specific faces
set-face global TSComment $colorscheme_dma_fg_subtle $colorscheme_dma_bg italic
set-face global TSString $colorscheme_dma_green_500 $colorscheme_dma_bg
set-face global TSNumber $colorscheme_dma_blue_500 $colorscheme_dma_bg
set-face global TSBoolean $colorscheme_dma_blue_500 $colorscheme_dma_bg
set-face global TSConstant $colorscheme_dma_warning_600 $colorscheme_dma_bg
set-face global TSFunction $colorscheme_dma_blue_500 $colorscheme_dma_bg
set-face global TSMethod $colorscheme_dma_blue_500 $colorscheme_dma_bg
set-face global TSKeyword $colorscheme_dma_teal_600 $colorscheme_dma_bg bold
set-face global TSKeywordFunction $colorscheme_dma_teal_600 $colorscheme_dma_bg
set-face global TSKeywordOperator $colorscheme_dma_teal_600 $colorscheme_dma_bg
set-face global TSKeywordReturn $colorscheme_dma_teal_600 $colorscheme_dma_bg
set-face global TSConditional $colorscheme_dma_teal_600 $colorscheme_dma_bg bold
set-face global TSRepeat $colorscheme_dma_teal_600 $colorscheme_dma_bg bold
set-face global TSOperator $colorscheme_dma_teal_600 $colorscheme_dma_bg
set-face global TSType $colorscheme_dma_teal_500 $colorscheme_dma_bg bold
set-face global TSTypeBuiltin $colorscheme_dma_teal_500 $colorscheme_dma_bg
set-face global TSVariable $colorscheme_dma_fg $colorscheme_dma_bg
set-face global TSVariableBuiltin $colorscheme_dma_fg $colorscheme_dma_bg italic
set-face global TSParameter $colorscheme_dma_fg_muted $colorscheme_dma_bg
set-face global TSProperty $colorscheme_dma_fg $colorscheme_dma_bg
set-face global TSField $colorscheme_dma_fg $colorscheme_dma_bg
set-face global TSAttribute $colorscheme_dma_turquoise_500 $colorscheme_dma_bg
set-face global TSTag $colorscheme_dma_teal_600 $colorscheme_dma_bg
set-face global TSTagDelimiter $colorscheme_dma_fg_muted $colorscheme_dma_bg
set-face global TSNamespace $colorscheme_dma_turquoise_500 $colorscheme_dma_bg
set-face global TSModule $colorscheme_dma_turquoise_500 $colorscheme_dma_bg
set-face global TSLabel $colorscheme_dma_fg_subtle $colorscheme_dma_bg
set-face global TSPunctuation $colorscheme_dma_fg_muted $colorscheme_dma_bg
set-face global TSBracket $colorscheme_dma_fg_subtle $colorscheme_dma_bg
set-face global TSRegex $colorscheme_dma_warning_600 $colorscheme_dma_bg
set-face global TSEscape $colorscheme_dma_warning_500 $colorscheme_dma_bg bold
set-face global TSAnnotation $colorscheme_dma_turquoise_500 $colorscheme_dma_bg
set-face global TSDecorator $colorscheme_dma_turquoise_500 $colorscheme_dma_bg

# Markup
set-face global TSMarkupHeading $colorscheme_dma_teal_900 $colorscheme_dma_bg bold
set-face global TSMarkupBold - $colorscheme_dma_bg bold
set-face global TSMarkupItalic - $colorscheme_dma_bg italic
set-face global TSMarkupStrikethrough - $colorscheme_dma_bg strikethrough
set-face global TSMarkupLink $colorscheme_dma_blue_500 $colorscheme_dma_bg underline
set-face global TSMarkupLinkUrl $colorscheme_dma_blue_500 $colorscheme_dma_bg underline
set-face global TSMarkupRaw $colorscheme_dma_green_700 $colorscheme_dma_bg_alt
set-face global TSMarkupList $colorscheme_dma_teal_900 $colorscheme_dma_bg

# Diff
set-face global TSDiffAdd $colorscheme_dma_green_600 $colorscheme_dma_success_50
set-face global TSDiffDelete $colorscheme_dma_error_500 $colorscheme_dma_error_50

# Hook to enable the theme
hook global WinSetOption colorscheme=dma-theme-light %{
    # The faces are already set above
}