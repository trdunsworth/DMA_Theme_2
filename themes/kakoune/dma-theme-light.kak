# DMA Theme Light for Kakoune
# Blues, teals, turquoises, and greens; warm error/warning accents.
# Dunsworth-Mann Analytics LLC - https://dunsworth-mann.com
# Flat `face global <Name> <spec>` per `:doc faces`. Canonical names.

face global Default             rgb:1A2A35,rgb:F8FAFC
face global BufferPadding       rgb:6E89A0,rgb:F8FAFC
face global Information         rgb:1A2A35,rgb:F0F4F8
face global InlineInformation   rgb:1A2A35,rgb:F0F4F8
face global Error               rgb:E80000,rgb:F0F4F8+b
face global Prompt              rgb:0077CC,rgb:F8FAFC+b
face global MenuForeground      rgb:0A0F14,rgb:A8D0F0
face global MenuBackground      rgb:1A2A35,rgb:F0F4F8
face global MenuInfo            rgb:6E89A0,rgb:F0F4F8
face global MatchingChar        rgb:F8FAFC,rgb:0077CC+bu
face global PrimaryCursor       rgb:F8FAFC,rgb:0077CC
face global SecondaryCursor     rgb:F8FAFC,rgb:A8D0F0
face global PrimaryCursorEol    rgb:F8FAFC,rgb:0077CC
face global SecondaryCursorEol  rgb:F8FAFC,rgb:A8D0F0
face global PrimarySelection    rgb:0A0F14,rgb:A8D0F0
face global SecondarySelection  rgb:1A2A35,rgb:D0E8F8
face global StatusLine          rgb:1A2A35,rgb:DCE4ED+b
face global StatusLineMode      rgb:F8FAFC,rgb:0077CC+b
face global StatusLineInfo      rgb:6E89A0
face global StatusLineValue     rgb:0077CC
face global StatusCursor        rgb:F8FAFC,rgb:0077CC
face global LineNumbers         rgb:6E89A0,rgb:F8FAFC
face global LineNumberCursor    rgb:0077CC,rgb:F8FAFC+b
face global LineNumbersWrapped  rgb:1A2A35,rgb:F8FAFC
face global Whitespace          rgb:E8EEF3
face global WrapMarker          rgb:E8EEF3
face global Search              rgb:F8FAFC,rgb:C47300+b
face global DiagnosticError     rgb:E80000
face global DiagnosticWarning   rgb:9E5E00
face global comment             rgb:6E89A0+i
face global documentation       rgb:6E89A0+i
face global string              rgb:009933
face global value               rgb:C47300
face global function            rgb:0077CC
face global type                rgb:008A8A+b
face global variable            rgb:1A2A35
face global module              rgb:007F7F
face global keyword             rgb:0077CC+b
face global operator            rgb:485C6E
face global attribute           rgb:008A8A
face global builtin             rgb:007F7F+b
face global meta                rgb:007F7F
face global identifier          rgb:1A2A35
face global mono                rgb:1A2A35
face global block               rgb:E88800
face global link                rgb:0077CC+u
face global bullet              rgb:E88800
face global list                rgb:0077CC
face global header              rgb:00529E
face global title               rgb:00529E